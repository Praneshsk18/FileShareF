{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/upload-ui/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fileshareb-v6tc.onrender.com/api/:path*"
    },
    {
      "source": "/upload/:path*",
      "destination": "https://fileshareb-v6tc.onrender.com/upload/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}